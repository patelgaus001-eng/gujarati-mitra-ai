];
const SIMPLE=[
["અત્યંત","ખૂબ","સરળ શબ્દ."],["સત્વરે","જલદી","સરળ શબ્દ."],["તત્કાલ","તરત","સરળ શબ્દ."],
["પ્રારંભ","શરૂઆત","રોજિંદો શબ્દ."],["આરંભ","શરૂઆત","રોજિંદો શબ્દ."],["અવશ્ય","જરૂર","રોજિંદો શબ્દ."],
["પ્રાપ્ત કરો","મેળવો","ટૂંકું અને સરળ."],["પ્રયત્ન","કોશિશ","બોલચાલનો શબ્દ."],
["ઉત્કૃષ્ટ","ઉત્તમ","સરળ શબ્દ."],["કદાપિ","ક્યારેય","રોજિંદો શબ્દ."]
];
// ===== Proofreading engine: rule-based demo (no AI, no internet, no paid service) =====
const G="\\u0A80-\\u0AFF"; // Gujarati letters, matras and digits
const rxe=s=>s.replace(/[.*+?^${}()|[\]\\]/g,"\\$&");
// More known spelling mistakes. Add your own: [wrong, right, reason]
SPELL.push(
["કાર્યકર્મ","કાર્યક્રમ","સાચો શબ્દ ‘કાર્યક્રમ’ (ક્ર)."],
["પરીવાર","પરિવાર","‘પરિવાર’ માં ‘રિ’ હ્રસ્વ છે."],
["અતિથી","અતિથિ","‘અતિથિ’ માં છેલ્લે હ્રસ્વ ‘િ’ આવે."],
["વિધ્યાલય","વિદ્યાલય","સાચો શબ્દ ‘વિદ્યાલય’ (દ્ + યા)."],
["સમ્માન","સન્માન","સાચી જોડણી ‘સન્માન’."],
["વ્યકત","વ્યક્ત","‘વ્યક્ત’ માં ‘ક્ત’ જોડાક્ષર છે."]
);
// Verbs that must end with ‘ું’ (add more here)
const VERBS=["ભર્યુ","કર્યુ","લખ્યુ","થયુ","હતુ","જોયુ","આપ્યુ","કહ્યુ","મળ્યુ","રહ્યુ","આવ્યુ","વાંચ્યુ","બોલ્યુ","પૂછ્યુ","ગમ્યુ","શીખ્યુ","સાંભળ્યુ"];
// Words that should be joined or replaced as a phrase
const PHRASES=[
["ભાવ ભર્યું","ભાવભર્યું","‘ભાવભર્યું’ એક જ સંયુક્ત શબ્દ છે, વચ્ચે જગ્યા નહીં."],
["સર્વે ને","સૌને","‘સૌને’ વધુ સહજ અને સરળ લાગે છે."],
["સર્વેને","સૌને","‘સૌને’ વધુ સહજ અને સરળ લાગે છે."]
];
// ‘મા’ can also mean “mother”, so it is left alone after these words
const KEEP_MA=["મારી","મારા","તારી","તમારી","પ્રિય","વહાલી","જય"];

function engine(text,mode){
  const c=MODECFG[mode]||MODECFG.proof,log=[],tips=[];let t=text;
  const rec=(key,a,b,why,n=1)=>{const e=log.find(x=>x.key===key);if(e)e.n+=n;else log.push({key,a,b,why,n})};
  const sub=(a,b,why)=>{const n=t.split(a).length-1;if(n){t=t.split(a).join(b);rec(a+">"+b,a,b,why,n)}};
  const pre=(a,b,why)=>{t=t.replace(new RegExp("(^|[^"+G+"])"+rxe(a),"g"),(m,p)=>{rec(a+">"+b,a,b,why);return p+b})};
  const word=(a,b,why)=>{t=t.replace(new RegExp("(^|[^"+G+"])"+rxe(a)+"(?!["+G+"])","g"),(m,p)=>{rec(a+">"+b,a,b,why);return p+b})};
