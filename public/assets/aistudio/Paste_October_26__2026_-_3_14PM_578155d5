const $=id=>document.getElementById(id);
const curCat=()=>CATS.find(c=>c.id===$("cat").value)||CATS[0];
function initUI(){
  $("cat").innerHTML=CATS.map(c=>`<option value="${c.id}">${c.ico} ${c.en} — ${c.gu}</option>`).join("");
  $("wmode").innerHTML=MODES.map(m=>`<option value="${m.id}">${m.en} — ${m.gu}</option>`).join("");
  $("wmode").value="proof";onCat();onMode();
}
function onCat(){
  const c=curCat(),w=WARN[c.warn];
  $("catHelp").textContent=c.ex;$("inp").placeholder=c.ph;$("otherBox").hidden=c.id!=="other";
  $("catWarn").hidden=!w;if(w)$("catWarn").textContent=w;
}
function onMode(){
  const m=MODES.find(x=>x.id===$("wmode").value)||MODES[2];
  $("modeHelp").textContent=m.desc;
  $("inpTitle").textContent=m.id==="generate"?"✍️ વિષય લખો · Enter your topic":"✍️ તમારું લખાણ લખો · Enter your text";
}
function catSample(){const c=curCat();$("inp").value=c.sample;$("wmode").value=c.smode||"proof";onMode();clearOut();$("askBox").hidden=true}
function ask(msg){clearOut();const b=$("askBox");b.textContent="❓ "+msg;b.hidden=false;b.scrollIntoView({behavior:"smooth",block:"center"})}
function render(title,src,html,plainText,items,tips){
  plain=plainText;
  $("mode").textContent=title;$("orig").textContent=src;$("res").innerHTML=html;
  const li=items.map(x=>"<li>"+x+"</li>");
  tips.forEach(x=>li.push("<li>"+(/^(❓|⚕|⚖|📌)/.test(x)?"":"💭 ")+esc(x)+"</li>"));
  $("why").innerHTML=li.join("");
  $("out").hidden=false;$("out").scrollIntoView({behavior:"smooth"});
}
const SAL=/માનનીય|સાહેબ|મહોદય|પ્રિય/;
const CHECKS={
  biz:t=>/સંપર્ક|ફોન|મોબાઈલ|સરનામું|[૦-૯0-9]/.test(t)?[]:["📌 જાહેરાતમાં સંપર્ક નંબર કે સરનામું ઉમેર્યું છે? (Add contact details.)"],
  invite:t=>{const m=["તારીખ","સમય","સ્થળ"].filter(x=>!t.includes(x));return m.length?["📌 આમંત્રણમાં આ વિગતો લખી છે? "+m.join(", ")+" (date, time, place)"]:[]},
  gov:t=>/તારીખ|આજે|કાલે/.test(t)?[]:["📌 જાહેર સૂચનામાં તારીખ અને કચેરી/વિભાગનું નામ લખ્યું છે? (Add date and office.)"],
  legal:t=>SAL.test(t)?[]:["📌 પત્રની શરૂઆતમાં સંબોધન (દા.ત. માનનીય સાહેબશ્રી) લખ્યું છે?"],
  prof:t=>[...(SAL.test(t)?[]:["📌 શરૂઆતમાં સંબોધન લખ્યું છે? (e.g. માનનીય મહોદય)"]),...(t.includes("આભાર")?[]:["📌 અંતે ‘આભાર’ લખવાનું વિચારો."])]
};
function run(m){$("wmode").value=m;onMode();go(m)}
function go(mode){
  const c=curCat(),src=$("inp").value,m=MODES.find(x=>x.id===mode)||MODES[2];
  $("askBox").hidden=true;
  if(c.id==="other"&&!$("otherBox").value.trim()){ask("‘અન્ય’ માટે તમારો હેતુ ઉપરના બોક્સમાં લખો. (Please describe your purpose.)");$("otherBox").focus();return}
  if(!src.trim()){ask(mode==="generate"?"પહેલા વિષય લખો, દા.ત. ‘શાળાનો વાર્ષિક ઉત્સવ’. (Please write a topic first.)":"પહેલા લખાણ લખો અથવા paste કરો. (Please enter some text first.)");return}
  const hasGu=new RegExp("["+G+"]").test(src),hasEn=/[A-Za-z]/.test(src);
  const purpose=c.id==="other"?$("otherBox").value.trim():c.en;
  const title=m.en+" · "+m.gu+" · "+purpose;
  const wt=c.warn?[WARNTIP[c.warn]]:[];
  if(mode==="generate"){
    if(!c.tpl){ask("આ હેતુ માટે નમૂનો નથી. ‘Translate to Gujarati’ મોડ વાપરો અથવા બીજો હેતુ પસંદ કરો.");return}
    if(src.trim().length<3){ask("વિષય બહુ ટૂંકો છે. થોડી વધુ વિગત લખો. (Topic is too short – please add a little more.)");return}
    const out=c.tpl(src.trim());
    return render(title,src,esc(out),out,["નમૂનો (template): “"+esc(c.en)+"” માટેના તૈયાર ઢાંચામાં તમારો વિષય મૂક્યો છે. આ AI નથી."],["❓ [ ] માં લખેલી વિગતો (તારીખ, સ્થળ, નામ વગેરે) તમારે જાતે ભરવી. કોઈ નવી માહિતી ઉમેરી નથી.",...wt]);
  }
  if(mode==="translate"){
    if(hasGu&&!hasEn){ask("આ લખાણ પહેલેથી ગુજરાતીમાં છે. સુધારવા માટે ‘Full Proofreading’ કે ‘Simple Gujarati’ પસંદ કરો. (Already Gujarati.)");return}
    const r=translateText(src);
    return render(title,src,hilite(src,r.out),r.out,r.items,[...r.tips,...wt]);
  }
  if(!hasGu){ask("આ લખાણમાં ગુજરાતી અક્ષરો નથી. અનુવાદ કરવો હોય તો ‘Translate to Gujarati’ મોડ પસંદ કરો. (No Gujarati found – did you want to translate?)");return}
  const r=engine(src,mode),total=r.log.reduce((a,e)=>a+e.n,0);
  const li=r.log.map(e=>e.a?`<b>${esc(e.a)}</b> → <b>${esc(e.b)}</b>${e.n>1?" (×"+e.n+")":""} · ${esc(e.why)}`:`${esc(e.why)} (×${e.n})`);
  if(!li.length)li.push("આ મોડના demo નિયમોમાં કોઈ ભૂલ મળી નથી. (No rule matched – this does not mean the text is perfect.)");
  const ck=CHECKS[c.id]?CHECKS[c.id](r.out):[];
  render(title+" · "+total+" corrections",src,hilite(src,r.out),r.out,li,[...r.tips,...ck,...wt]);
}
function buildTests(){
  const box=document.getElementById("tests");
  TESTS.forEach((t,i)=>{const b=document.createElement("button");b.textContent="Test "+(i+1)+": "+t.label;
    b.onclick=()=>{const q=document.getElementById("askBox");document.getElementById("inp").value=t.text;document.getElementById("wmode").value=t.mode||"proof";onMode();clearOut();q.textContent="🧪 Test "+(i+1)+" loaded · mode: "+(t.mode||"proof")+" · Expected: "+t.expected;q.hidden=false;window.scrollTo({top:0,behavior:"smooth"})};box.appendChild(b)});
}
function runAll(){
  document.getElementById("testOut").innerHTML=TESTS.map((t,i)=>{
    const got=engine(t.text,t.mode||"proof").out,ok=got===t.expected;
    return `<div class="tc"><b class="${ok?"pass":"fail"}">${ok?"✅ PASS":"❌ FAIL"}</b> Test ${i+1}: ${esc(t.label)}${ok?"":`<div class="note">Expected: ${esc(t.expected)}<br>Got: ${esc(got)}</div>`}</div>`}).join("");
}
function clearOut(){document.getElementById("out").hidden=true;plain=""}
async function copyText(str,btn,label){
  let ok=true;
  try{await navigator.clipboard.writeText(str)}
  catch(e){try{const ta=document.createElement("textarea");ta.value=str;document.body.appendChild(ta);ta.select();ok=document.execCommand("copy");ta.remove()}catch(_){ok=false}}
  btn.textContent=ok?"✅ Copied!":"⚠️ Copy failed";setTimeout(()=>btn.textContent=label,1800);
}
function copyRes(){
  const b=document.getElementById("cp");
  if(!plain){b.textContent="Nothing to copy";setTimeout(()=>b.textContent="📋 Copy Result",1500);return}
  copyText(plain,b,"📋 Copy Result");
}
function clearAll(){
  document.getElementById("inp").value="";clearOut();
  document.getElementById("askBox").hidden=true;document.getElementById("testOut").innerHTML="";
  document.getElementById("inp").focus();
}
const SAMPLES={
para:"ગુજરાતિ ભાષા આપણી સંસ્કૃતી નો અમૂલ્ય વારસો છે.  દરેક વિધાર્થી એ પરિક્ષા પહેલા સુચના અવશ્ય વાંચવી  .  કૃપયા સત્વરે સંપર્ક સાધો.",
banner:"દિપાવલી ની હાર્દિક શુભેછા !  નવા વર્ષે અભીનંદન.  સ્વછતા નું મહત્વ સમજો,  સુવીધા નો ઉપયોગ કરો."
